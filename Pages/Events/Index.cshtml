@page
@model SmartCalendar.Pages.Events.IndexModel
@{
}

@foreach (var Event in Model.events)
{
    <div>
        <h3>@Event.Name</h3>
        <p>@Event.Date</p>
        <p>@Event.EndDate</p>
        <p>@Event.Location</p>
        <p>@Event.StartTime</p>
        <p>@Event.EndTime</p>
        <p>@Event.Note</p>
        <p>@Event.Colour</p>
        <a href=""> View </a>
    </div>
}
